# 后台管理前端配置（admin 目录）

# 本地开发环境：留空，由 vite.config.js 自动代理 /wardrobe-admin 并去掉前缀转发到后端
# （前端 api/index.js 路径为 /wardrobe-admin/admin/*，vite 把 /wardrobe-admin 替换为空转发到 localhost:3000）
VITE_API_BASE=/wardrobe-admin

# 后端地址（仅 dev 代理使用，可改端口，不要带 /wardrobe-admin 后缀）
VITE_API_TARGET=http://localhost:3000

# 生产环境用法：将下方内容复制到 .env.production（或线上构建环境）
#   VITE_API_BASE=https://wardrobe.maidane.com
# 此时前端仍以 /wardrobe-admin/admin/* 拼接完整 URL，不再走 vite 代理，
# 由线上 nginx 将 /wardrobe-admin 反代到后端并去掉前缀

# ---------------------------------------------------------------------------
# 管理员账号在 backend/.env 中配置（后端 /admin/login 校验）：
#   ADMIN_USER=admin
#   ADMIN_PASS=你的强密码
# ---------------------------------------------------------------------------
