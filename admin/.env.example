# 后台管理前端配置（admin 目录）
#
# api/index.js 中的接口路径统一为 /admin/*，不含前缀：
#   - 本地开发（VITE_API_BASE 留空）：vite.config.js 自动代理 /admin 并补全
#     /wardrobe-admin 前缀转发到后端（默认 http://localhost:3000）
#   - 生产环境（配置 VITE_API_BASE）：值需包含完整前缀，前端直接以此 baseURL 拼接，
#     由线上 nginx 将 /wardrobe-admin 反代到后端

# 本地开发（默认）：留空即可，vite 将 /wardrobe-admin 代理到后端并去掉前缀
# VITE_API_BASE=

# 生产环境：指向线上后端域名（前端路径自带 /wardrobe-admin，由 nginx 反代并去前缀）
# VITE_API_BASE=https://wardrobe.maidane.com

# 后端地址（仅 dev 代理使用）
# VITE_API_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
# 管理员账号在 backend/.env 中配置（后端 /wardrobe-admin/admin/login 校验）：
#   ADMIN_USER=admin
#   ADMIN_PASS=你的强密码
# ---------------------------------------------------------------------------
