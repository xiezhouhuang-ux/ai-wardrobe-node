# ============================================================
#  AI Wardrobe · 配置文件 (.env)
#  说明：复制本文件后按需修改，服务启动时由 lib/env.js 自动加载。
#        未设置的项使用代码中的默认值（已在右侧标注）。
# ============================================================

# --- 阿里云 DashScope / MaaS API Key ---
# 留空 = 进入 DEMO 模式（返回 mock 识别结果，仅供演示流程，不产生真实 AI 调用）。
# 填写真实 Key 后自动切换为 LIVE 模式。
QWEN_API_KEY=

# --- 模型 A：视觉理解（服饰检测 + 属性标签）---
# 走 OpenAI 兼容接口（你当前指向 MaaS 工作区 ws-tw4ykgd0zpr1i7cm）。
# 注意：DashScope 没有 "qwen2.5-vl-max"！以下才是真实存在的视觉模型 ID：
#   qwen2.5-vl-72b-instruct  (推荐，能力最强)
#   qwen2.5-vl-32b-instruct
#   qwen-vl-max / qwen-vl-plus  (旧版)
#   qwen3-vl-plus / qwen3-vl-flash  (最新一代)
# ⚠️ 若仍报 "Model not exist"，说明该模型未在 MaaS 工作区部署：
#   去 百炼控制台 → 该工作区 → 模型部署，确认已部署且名称与此一致。
QWEN_MODEL=qwen3.7-plus

# --- 模型 B：图像生成/编辑（服饰分割 / 去背景 / 补全）---
# 走 DashScope 多模态生成接口。默认：qwen-image-2.0-pro
QWEN_IMAGE_MODEL=qwen-image-edit-plus

# --- 可选：MaaS 工作区专用地址 ---
# 非 MaaS 用户全部留空，自动使用 DashScope 公网默认地址。
# 视觉理解（VL）OpenAI 兼容地址，例如：
#   QWEN_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

QWEN_BASE_URL=


# 图像生成/编辑（qwen-image）多模态生成地址，例如：

#   QWEN_IMAGE_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation


QWEN_IMAGE_ENDPOINT=

# --- 服务端口 ---
# 默认：3000
PORT=3000

# --- 本地透明背景抠图兜底 ---
# 依赖可选包 @imgly/background-removal-node；装不上会自动降级为裁剪图。
# 1 = 启用尝试（默认），0 = 关闭
ENABLE_CUTOUT=1
