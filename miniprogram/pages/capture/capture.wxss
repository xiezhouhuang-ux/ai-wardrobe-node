.capture-page {
  min-height: 100vh;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-bg, #f5ede3);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* === 大型虚线框 === */
.capture-frame {
  position: relative;
  margin-top: 16rpx;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx);
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-line, #e7dccb);
  flex: 1;
  min-height: 760rpx;
}
.capture-frame:active { transform: scale(0.995); }
.capture-frame.disabled { opacity: 0.7; pointer-events: none; }
.capture-frame.has-image { padding: 40rpx; }

.capture-emoji { font-size: 120rpx; line-height: 1; }
.capture-text {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text, #3a2a1f);
  letter-spacing: 2rpx;
}
.capture-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-mute, #b9ad9c);
  text-align: center;
  line-height: 1.5;
}

.capture-img {
  width: 100%;
  max-height: 880rpx;
  border-radius: var(--radius-md, 24rpx);
}
.capture-overlay {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  background: rgba(58, 42, 31, 0.6);
  color: #fffaf3;
  font-size: 22rpx;
  border-radius: 999rpx;
}

/* === 提示胶囊 === */
.capture-tips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.tip-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: var(--color-surface, #fffaf3);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text, #3a2a1f);
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(58,42,31,0.05));
}
.tip-ico { font-size: 26rpx; }

/* === 底部主按钮 === */
.capture-bottom {
  margin-top: 32rpx;
}
.btn-cta {
  display: flex;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(201,107,74,0.25);
}
.btn-cta.disabled {
  opacity: 0.5;
}
.btn-cta[disabled] { opacity: 0.5; }