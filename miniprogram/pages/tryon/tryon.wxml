<!--pages/tryon/tryon.wxml-->
<view class="tryon-page page-with-nav">
  <nav-bar title="AI 试穿"></nav-bar>

  <view class="sub">请选择一位用户，进入其衣橱进行试穿</view>

  <view wx:if="{{loadingUsers}}" class="empty">加载用户列表中…</view>
  <view wx:elif="{{!users.length}}" class="empty">暂无用户</view>
  <view wx:else class="user-list">
    <view
      class="user-row {{u.isSelf ? 'self' : ''}}"
      wx:for="{{users}}"
      wx:key="openid"
      wx:for-item="u"
      data-openid="{{u.openid}}"
      bindtap="enterWardrobe"
    >
      <image wx:if="{{u.avatar}}" class="user-avatar" src="{{u.avatar}}" mode="aspectFill"></image>
      <view wx:else class="user-avatar placeholder">{{u.initial}}</view>
      <view class="user-info">
        <view class="user-name">
          {{u.nickname || '未命名用户'}}
          <text wx:if="{{u.isSelf}}" class="tag-self">本人</text>
        </view>
      </view>
      <text class="enter">进入衣橱 ›</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">⚠️ {{error}}</view>

  <view class="safe-bottom"></view>
</view>
