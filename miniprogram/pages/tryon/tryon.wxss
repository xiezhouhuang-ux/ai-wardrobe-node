/* pages/tryon/tryon.wxss —— 用户列表（统一暖色设计系统）  */
.tryon-page {
  min-height: 100vh;
  background: var(--color-bg, #f5ede3);
  padding: 0 32rpx 200rpx;
  box-sizing: border-box;
}

.sub {
  font-size: 26rpx;
  color: var(--color-text-soft, #8b7a6a);
  padding: 24rpx 8rpx 12rpx;
}

.empty {
  text-align: center;
  color: var(--color-text-mute, #b9ad9c);
  font-size: 28rpx;
  padding: 120rpx 0;
}

.user-list {
  margin-top: 8rpx;
}

.user-row {
  display: flex;
  align-items: center;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58, 42, 31, 0.06));
}

/* 自己置顶：暖色高亮，与其他用户区分 */
.user-row.self {
  background: var(--color-tag-bg, #f0e4d3);
  border: 2rpx solid var(--color-accent, #c96b4a);
}

.tag-self {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  color: #fffaf3;
  background: var(--color-accent, #c96b4a);
  border-radius: var(--radius-pill, 999rpx);
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-surface-2, #efe5d7);
}

.user-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-accent, #c96b4a);
  font-size: 34rpx;
  font-weight: 600;
  background: var(--color-tag-bg, #f0e4d3);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #3a2a1f);
}

.user-openid {
  font-size: 22rpx;
  color: var(--color-text-mute, #b9ad9c);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.enter {
  font-size: 26rpx;
  color: var(--color-accent, #c96b4a);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.error {
  color: #e5484d;
  font-size: 26rpx;
  text-align: center;
  margin: 16rpx 0;
}

.safe-bottom {
  height: 40rpx;
}
