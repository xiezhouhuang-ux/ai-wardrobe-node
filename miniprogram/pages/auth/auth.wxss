.auth-page {
  min-height: 100vh;
  background: var(--color-bg, #f5ede3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.auth-card {
  width: 100%;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx);
  padding: 72rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(58,42,31,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  font-size: 96rpx;
  line-height: 1;
}
.title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text, #3a2a1f);
}
.desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-soft, #8b7a6a);
  text-align: center;
  line-height: 1.6;
}
.auth-btn {
  margin-top: 56rpx;
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: var(--color-accent, #c96b4a);
  color: #fffaf3;
  font-size: 30rpx;
  border-radius: var(--radius-sm, 16rpx);
}
.auth-btn::after { border: none; }
.skip {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-mute, #b9ad9c);
}
