.detail-page {
  min-height: 100vh;
  padding: 0 32rpx 220rpx;
  background: var(--color-bg, #f5ede3);
}

.hero-card {
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  margin-bottom: 32rpx;
}
.hero-cover {
  position: relative;
  background: #FFF;
  border-radius: var(--radius-md, 24rpx);
  width: 100%;
  height: 700rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-tag {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: var(--color-accent, #c96b4a);
  color: #fffaf3;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.meta-card {
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  margin-bottom: 24rpx;
}
.meta-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text, #3a2a1f);
}
.meta-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
}

.source-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm, 16rpx);
  background: #fff;
  flex-shrink: 0;
}

.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}
.meta-cell {
  background: var(--color-surface-2, #efe5d7);
  border-radius: var(--radius-sm, 16rpx);
  padding: 20rpx;
}
.meta-cell-label {
  font-size: 22rpx;
  color: var(--color-text-mute, #b9ad9c);
}
.meta-cell-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: var(--color-text, #3a2a1f);
  font-weight: 600;
  display: flex;
  align-items: center;
}
.meta-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}

.hash-row {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.hash {
  font-size: 24rpx;
  color: var(--color-accent, #c96b4a);
  background: var(--color-tag-bg, #f0e4d3);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.action-card {
  display: flex;
  align-items: center;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 28rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  margin-bottom: 32rpx;
}
.action-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-pill, #efe5d7);
  border-radius: var(--radius-sm, 16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.action-body { flex: 1; }
.action-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #3a2a1f);
}
.action-desc {
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
  margin-top: 4rpx;
}
.action-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--color-accent, #c96b4a);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-row {
  display: flex;
  gap: 16rpx;
}
.footer-btn { flex: 1; }
.footer-btn.btn-primary { background: var(--color-accent, #c96b4a); color: #fff; }