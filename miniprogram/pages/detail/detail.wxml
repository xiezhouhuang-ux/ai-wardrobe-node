<!--pages/detail/detail.wxml-->
<view class="detail-page page-with-nav">
  <nav-bar title="服装卡片" back="{{true}}"></nav-bar>

  <view class="hero-card">
    <view class="hero-cover">
      <image class="hero-img" src="{{item.image}}" mode="aspectFit"></image>
      <view class="hero-tag">AI 抠图 · 正面</view>
    </view>
  </view>

  <view class="meta-card">
    <view class="meta-name">{{item.name || item.category}}</view>
    <view class="meta-sub">{{item.color}} · {{item.style}}</view>

    <view class="meta-grid">
      <view class="meta-cell">
        <view class="meta-cell-label">品类</view>
        <view class="meta-cell-value">{{item.category}}</view>
      </view>
      <view class="meta-cell">
        <view class="meta-cell-label">颜色</view>
        <view class="meta-cell-value">
          <text class="meta-dot" style="background:{{dotColor}};"></text>
          {{item.color}}
        </view>
      </view>
      <view class="meta-cell">
        <view class="meta-cell-label">适合季节</view>
        <view class="meta-cell-value">{{seasonText}}</view>
      </view>
      <view class="meta-cell">
        <view class="meta-cell-label">风格</view>
        <view class="meta-cell-value">{{item.style}}</view>
      </view>
    </view>

    <view class="hash-row" wx:if="{{hashList.length}}">
      <text class="hash" wx:for="{{hashList}}" wx:key="*this">#{{item}}</text>
    </view>
  </view>

  <view class="action-card">
    <view class="action-icon">🧩</view>
    <view class="action-body">
      <view class="action-title">用这件单品生成搭配</view>
      <view class="action-desc">AI 推荐与之相配的穿搭方案</view>
    </view>
    <view class="action-arrow" bindtap="onTryOn">›</view>
  </view>

  <view class="footer-row">
    <button class="btn btn-primary footer-btn" bindtap="onGenerate">生成搭配</button>
    <button class="btn btn-secondary footer-btn" bindtap="onBack">返回衣橱</button>
    <button class="btn btn-ghost footer-btn" bindtap="onDelete">删除卡片</button>
  </view>

  <view class="safe-bottom"></view>
</view>