.review-page {
  min-height: 100vh;
  padding: 0 32rpx 220rpx;
  background: var(--color-bg, #f5ede3);
}
.review-tip {
  font-size: 26rpx;
  color: var(--color-text-soft, #8b7a6a);
  padding: 16rpx 0 24rpx;
}

.item-list { display: flex; flex-direction: column; gap: 24rpx; }

.item-row {
  display: flex;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 20rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
}
.row-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm, 16rpx);
  background: #efe5d7;
  overflow: hidden;
  flex-shrink: 0;
}
.row-img { width: 100%; height: 100%; }
.row-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.row-line {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  border-bottom: 1rpx solid var(--color-line, #e7dccb);
  font-size: 26rpx;
}
.row-label {
  width: 96rpx;
  color: var(--color-text-soft, #8b7a6a);
}
.row-value {
  flex: 1;
  color: var(--color-text, #3a2a1f);
  font-weight: 500;
}
.row-input {
  flex: 1;
  color: var(--color-text, #3a2a1f);
  font-weight: 500;
}
.row-ph {
  color: var(--color-text-mute, #b9ad9c);
}
.row-arrow {
  color: var(--color-text-mute, #b9ad9c);
  font-size: 22rpx;
}

.row-seasons {
  display: flex;
  align-items: center;
  padding-top: 6rpx;
}
.season-list {
  flex: 1;
  display: flex;
  gap: 12rpx;
}
.season-chip {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-surface-2, #efe5d7);
  color: var(--color-text-soft, #8b7a6a);
  font-size: 22rpx;
}
.chip-on {
  background: var(--color-accent, #c96b4a);
  color: #fffaf3;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  padding: 0 32rpx;
  display: flex;
  justify-content: center;
}
.footer .btn-block {
  width: 60%;
  max-width: 420rpx;
}
.btn-large { height: 96rpx; line-height: 96rpx; font-size: 32rpx; }

/* 单品勾选框 */
.row-check {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 250, 243, 0.9);
  border: 2rpx solid var(--color-line, #e7dccb);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.row-check.on {
  background: var(--color-accent, #c96b4a);
  border-color: var(--color-accent, #c96b4a);
}
.row-check-dot {
  width: 18rpx;
  height: 10rpx;
  border: solid #fff;
  border-width: 0 0 4rpx 4rpx;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}
.item-row.row-off { opacity: 0.55; }
.item-row.row-off .row-img { filter: grayscale(0.4); }