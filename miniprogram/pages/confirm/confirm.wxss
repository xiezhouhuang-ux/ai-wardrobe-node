.confirm-page {
  min-height: 100vh;
  background: var(--color-bg, #f5ede3);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.confirm-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
}

/* 原图 */
.photo-box {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx);
  padding: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(58,42,31,0.05));
}
.photo-img {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-md, 24rpx);
  background: #f0e8dc;
}
.photo-box .tag {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  background: rgba(58, 42, 31, 0.6);
  color: #fffaf3;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* 标题 */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 0 12rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; color: var(--color-text, #3a2a1f); }
.sec-count { font-size: 24rpx; color: var(--color-text-mute, #b9ad9c); }

.select-all {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--color-text, #3a2a1f);
  margin-bottom: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-line, #e7dccb);
  background: #fff;
  box-sizing: border-box;
  position: relative;
  flex: none;
}
.checkbox.on {
  background: var(--color-accent, #c96b4a);
  border-color: var(--color-accent, #c96b4a);
}
.checkbox.on::after {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  width: 10rpx;
  height: 18rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.candidate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-surface, #fffaf3);
  border: 2rpx solid var(--color-line, #e7dccb);
  border-radius: var(--radius-md, 24rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  transition: .15s;
}
.candidate.off { opacity: 0.5; }
.candidate:active { border-color: var(--color-accent, #c96b4a); }
.candidate.row-done { border-color: var(--color-accent, #c96b4a); background: #fff6f1; }

/* 单品处理状态（右侧） */
.cell-status {
  flex: none;
  width: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell-done {
  color: var(--color-accent, #c96b4a);
  font-size: 36rpx;
  font-weight: 700;
}
.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-line, #e7dccb);
  border-top-color: var(--color-accent, #c96b4a);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 分割完成后的缩略图 */
.thumb {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md, 24rpx);
  background: var(--color-surface-2, #efe5d7);
  border: 2rpx solid var(--color-line, #e7dccb);
}
.thumb:active { opacity: 0.85; }

.meta { flex: 1; }
.row1 { display: flex; align-items: center; gap: 12rpx; }
.cate { font-size: 28rpx; font-weight: 600; color: var(--color-text, #3a2a1f); }
.color { font-size: 26rpx; color: var(--color-text-mute, #b9ad9c); }
.row2 { font-size: 24rpx; color: var(--color-text-mute, #b9ad9c); margin-top: 6rpx; }

.empty {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-mute, #b9ad9c);
}
.error {
  color: #e23b3b;
  font-size: 24rpx;
  margin: 8rpx 0 16rpx;
}
.bottom-gap { height: 24rpx; }

/* 底部操作栏 */
.footer {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg, #f5ede3);
  box-shadow: 0 -2rpx 12rpx rgba(58,42,31,0.04);
}
.footer-btn-re { flex: none; width: 200rpx; background: var(--color-surface, #fffaf3); }
.footer-btn-go { flex: 1; }

/* 处理阶段底部进度条 */
.proc-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.proc-track {
  width: 100%;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--color-surface-2, #efe5d7);
  overflow: hidden;
}
.proc-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-accent, #c96b4a), var(--color-accent-soft, #e6a48a));
  transition: width 0.25s ease;
}
.proc-text {
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
  text-align: center;
}
