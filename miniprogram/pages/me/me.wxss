.me-page {
  min-height: 100vh;
  padding: 0 32rpx 220rpx;
  background: var(--color-bg, #f5ede3);
}

/* 全身照卡片 */
.photo-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 24rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  margin-bottom: 24rpx;
}
.pc-thumb-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-sm, 16rpx);
  overflow: hidden;
  flex-shrink: 0;
  background: #efe5d7;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-empty { border: 2rpx dashed var(--color-line, #e7dccb); }
.pc-ico { font-size: 48rpx; }
.pc-thumb {
  width: 100%;
  height: 100%;
}
.pc-info { flex: 1; min-width: 0; }
.pc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text, #3a2a1f);
}
.pc-sub {
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
  margin-top: 6rpx;
}
.pc-arrow {
  font-size: 40rpx;
  color: var(--color-text-mute, #b9ad9c);
  flex-shrink: 0;
}

.me-hero {
  display: flex;
  align-items: center;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  margin-bottom: 24rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-accent, #c96b4a), var(--color-accent-soft, #e6a48a));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.avatar-text {
  font-size: 56rpx;
  color: #fffaf3;
  font-weight: 700;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}
.auth-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  background: var(--color-accent, #c96b4a);
  color: #fffaf3;
  font-size: 24rpx;
  border-radius: 999rpx;
}

/* 完善资料弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(58,42,31,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.edit-sheet {
  width: 100%;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-lg, 32rpx) var(--radius-lg, 32rpx) 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.edit-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text, #3a2a1f);
  margin-bottom: 36rpx;
}
.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0 0 32rpx;
  line-height: normal;
}
.avatar-picker::after { border: none; }
.edit-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  background: #efe5d7;
}
.edit-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-mute, #b9ad9c);
  font-size: 64rpx;
}
.avatar-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
}
.nick-input {
  width: 100%;
  height: 88rpx;
  background: var(--color-pill, #efe5d7);
  border-radius: var(--radius-sm, 16rpx);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--color-text, #3a2a1f);
  margin-bottom: 32rpx;
}
.edit-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-accent, #c96b4a);
  color: #fffaf3;
  font-size: 30rpx;
  border-radius: var(--radius-sm, 16rpx);
}
.me-info { flex: 1; }
.me-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text, #3a2a1f);
}
.me-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-accent, #c96b4a);
}
.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-soft, #8b7a6a);
}

.menu-card {
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
  overflow: hidden;
}
.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--color-line, #e7dccb);
}
.menu-row:last-child { border-bottom: none; }
.menu-ico {
  width: 56rpx;
  height: 56rpx;
  background: var(--color-pill, #efe5d7);
  border-radius: var(--radius-sm, 16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text, #3a2a1f);
}
.menu-arrow {
  font-size: 36rpx;
  color: var(--color-text-mute, #b9ad9c);
  font-weight: 300;
}

.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-mute, #b9ad9c);
}

.logout-btn {
  margin: 24rpx 32rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface, #fffaf3);
  border-radius: var(--radius-md, 24rpx);
  color: #c0392b;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: var(--shadow-card, 0 8rpx 24rpx rgba(58,42,31,0.06));
}
.logout-btn:active { opacity: 0.7; }